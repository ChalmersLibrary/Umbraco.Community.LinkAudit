<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Razor Class Library (Microsoft.NET.Sdk.Razor) packs wwwroot as static web assets.
         StaticWebAssetBasePath=/ serves them at the site root (/App_Plugins/UmbracoCommunity.LinkAudit/...)
         instead of under _content/. We ship no .cshtml views, so MVC Razor support is not needed. -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>

    <!-- The backoffice manifest: generated by StampUmbracoPackageManifest, gitignored, and declared as an
         explicit Content item below rather than by the SDK's wwwroot glob (see there for why). -->
    <UmbracoPackageManifest>wwwroot/App_Plugins/UmbracoCommunity.LinkAudit/umbraco-package.json</UmbracoPackageManifest>

    <!-- build/ holds NuGet build assets (a .targets + appsettings schema) packed explicitly into
         buildTransitive/ below; the template JSON is read at build time by StampUmbracoPackageManifest.
         Keep both out of the SDK's default Content/None globs, or they'd leak into content//contentFiles/. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);build/**;umbraco-package.template.json;$(UmbracoPackageManifest)</DefaultItemExcludes>

    <!-- ONE build for every supported Umbraco major.
         The only members that move between majors are IPublishedContent.Name/.Cultures (pushed down to
         IPublishedElement in 18); PublishedContentCompat resolves those by name at runtime, and every other
         Umbraco member this package touches is declaration-identical across majors. So the assembly is
         compiled once, against the OLDEST supported version, and runs against whatever the consuming site
         resolves.

         UmbracoFloorVersion is the minimum: 17.5.0, set by RecurringBackgroundJobBase.RunJobAsync(
         CancellationToken), which does not exist before it.
         UmbracoNextMajorVersion is an exclusive upper bound. Without it, this package would install onto a
         future major it has never been tested against and fail at RUNTIME; with it, an untested major is a
         restore-time error instead. Raise it deliberately, after testing that major. -->
    <UmbracoFloorVersion>17.5.0</UmbracoFloorVersion>
    <UmbracoNextMajorVersion>19.0.0</UmbracoNextMajorVersion>
    <UmbracoVersionRange>[$(UmbracoFloorVersion), $(UmbracoNextMajorVersion))</UmbracoVersionRange>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>Umbraco.Community.LinkAudit</PackageId>
    <Title>Link Audit</Title>
    <!-- LinkAudit's OWN version — plain semver, carrying NO information about Umbraco. Which Umbraco
         versions this package supports is declared by UmbracoVersionRange above, which the Marketplace reads
         and NuGet enforces; a version number cannot express a range, so it does not try. Release notes and
         the history behind the 2.x break live in CHANGELOG.md. -->
    <LinkAuditVersion Condition="'$(LinkAuditVersion)' == ''">2.0.1</LinkAuditVersion>
    <Version Condition="'$(VersionSuffix)' == ''">$(LinkAuditVersion)</Version>
    <Version Condition="'$(VersionSuffix)' != ''">$(LinkAuditVersion)-$(VersionSuffix)</Version>
    <Authors>Rolf Johansson, Claude (Anthropic)</Authors>
    <Company>Chalmers University of Technology</Company>
    <Copyright>Copyright © 2026 Rolf Johansson, Chalmers University of Technology</Copyright>
    <Description>A lightweight, single-purpose link auditor for Umbraco. Scans published content on a schedule (or on demand), reports broken external links and links that point at hosts you would rather keep internal — all from a read-only backoffice dashboard. Reads the content cache directly rather than crawling the rendered site.</Description>
    <PackageTags>umbraco umbraco-marketplace plugin package links link-checker broken-links seo audit</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ChalmersLibrary/Umbraco.Community.LinkAudit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ChalmersLibrary/Umbraco.Community.LinkAudit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Views/analyzers warnings guard: keep the package warning-clean. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Controllers use ASP.NET Core types (StatusCodes, etc.); a class library must reference the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- A range, not a pin: NuGet compiles against the lowest version in the range (the floor) and lets the
         consuming site resolve any higher version within it. -->
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="$(UmbracoVersionRange)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="$(UmbracoVersionRange)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Do not replace this with the SDK's wwwroot glob, and do not un-exclude it from DefaultItemExcludes.
         The manifest is generated during the build, but that glob is evaluated when the project loads, so on
         a clean checkout (CI, always) it finds nothing and the manifest never becomes a static web asset —
         which ships a package with no umbraco-package.json at all: Umbraco then does not discover the package,
         so no dashboard and no entry under Installed packages. This is how 2.0.0 broke. A literal Include
         yields an item whether or not the file exists yet. Metadata mirrors the SDK's own wwwroot glob. -->
    <Content Include="$(UmbracoPackageManifest)"
             ExcludeFromSingleFile="true"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship README + icon inside the NuGet package (not the marketplace file, which is host-side). -->
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Condition="Exists('../../icon.png')" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings IntelliSense/validation for the "LinkAudit" section. The .props is auto-imported into
         the consuming site (buildTransitive); it registers the schema with Umbraco's schema pipeline, which
         copies the .json into the site and $ref's it from appsettings-schema.json. Both files must sit in
         buildTransitive/ so $(MSBuildThisFileDirectory) resolves the schema next to the props. -->
    <None Include="build/Umbraco.Community.LinkAudit.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="build/appsettings-schema.LinkAudit.json" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <!-- Umbraco discovers this package by its umbraco-package.json; the "version" it shows under Installed
       packages is independent of the NuGet/assembly version, so stamp it from $(Version) to keep the two in
       step. The manifest is generated from umbraco-package.template.json (the tracked source) and is
       gitignored.

       Ordering: this must run before ResolveCurrentProjectStaticWebAssetsInputs, the target that turns
       Content items under wwwroot into static web assets — that is the point at which the file must exist on
       disk. Its declaration as a Content item is handled at evaluation time above, which is what makes this
       work on a clean checkout. -->
  <Target Name="StampUmbracoPackageManifest"
          BeforeTargets="ResolveCurrentProjectStaticWebAssetsInputs;ResolveProjectStaticWebAssets;AssignTargetPaths;BeforeBuild">
    <PropertyGroup>
      <_UmbPkgTemplate>$(MSBuildProjectDirectory)/umbraco-package.template.json</_UmbPkgTemplate>
      <_UmbPkgOutput>$(MSBuildProjectDirectory)/$(UmbracoPackageManifest)</_UmbPkgOutput>
      <_UmbPkgContent>$([System.IO.File]::ReadAllText('$(_UmbPkgTemplate)').Replace('__PACKAGE_VERSION__', '$(Version)'))</_UmbPkgContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_UmbPkgOutput)" Lines="$(_UmbPkgContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
